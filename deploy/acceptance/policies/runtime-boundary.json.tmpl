{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDevData",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "ReadDevData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "WriteAndCleanupDevData",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:RestoreObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/packs/*",
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/packs-index/*",
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/journal/*",
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/checkpoints/*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "DevMetadata",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:${REGION}:${ACCOUNT_ID}:table/miles-dev-*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "DevCrypto",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:${REGION}:${ACCOUNT_ID}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "dev"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "BootstrapConfig",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:${REGION}:${ACCOUNT_ID}:parameter/miles-dev/bootstrap-config"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "DevSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:${REGION}:${ACCOUNT_ID}:secret:miles-dev/runtime-secrets-*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "RuntimeLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:${REGION}:${ACCOUNT_ID}:log-group:/miles-dev/runtime:*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "RuntimeMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "Miles/DSG"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "DrainDevTargets",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeregisterTargets"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:${REGION}:${ACCOUNT_ID}:targetgroup/miles-dev-s3/*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "DevLifecycle",
      "Effect": "Allow",
      "Action": [
        "autoscaling:RecordLifecycleActionHeartbeat",
        "autoscaling:CompleteLifecycleAction"
      ],
      "Resource": [
        "arn:aws:autoscaling:${REGION}:${ACCOUNT_ID}:autoScalingGroup:*:autoScalingGroupName/miles-dev-*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "RegisterDevNode",
      "Effect": "Allow",
      "Action": [
        "ssm:UpdateInstanceInformation"
      ],
      "Resource": [
        "arn:aws:ec2:${REGION}:${ACCOUNT_ID}:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${REGION}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "AgentChannels",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${REGION}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "VerifySessionLogEncryption",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${REGION}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "ReadVersionedRelease",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/releases/*",
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/acceptance-assets/edge/*",
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}/acceptance-assets/client/*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "ObserveTargetDrain",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "${REGION}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "PilotDirectBucket",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-pilot-direct-${ACCOUNT_ID}-${REGION}"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "PilotDirectObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-pilot-direct-${ACCOUNT_ID}-${REGION}/warmbench/*"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    },
    {
      "Sid": "PilotVersionInventory",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-data-${ACCOUNT_ID}-${REGION}"
      ],
      "Condition": {
        "DateLessThan": {
          "aws:CurrentTime": "${IAM_EXPIRY}"
        }
      }
    }
  ]
}
