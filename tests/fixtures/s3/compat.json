    {"name":"suffix longer than object","size":100,"range":"bytes=-5000","status":206,"start":0,"length":100,"content_range":"bytes 0-99/100"},
    {"name":"start at size","size":100,"range":"bytes=100-","error":"InvalidRange","status":416},
    {"name":"start beyond size","size":100,"range":"bytes=150-","error":"InvalidRange","status":416},
    {"name":"closed range past size","size":100,"range":"bytes=100-200","error":"InvalidRange","status":416},
    {"name":"suffix zero","size":100,"range":"bytes=-0","error":"InvalidRange","status":416,"note":"bytes=-0 không giao object nào, S3 trả 416"},
    {"name":"start above end","size":100,"range":"bytes=7-3","error":"InvalidRange","status":416},
    {"name":"not digits","size":100,"range":"bytes=a-b","error":"InvalidRange","status":416},
    {"name":"empty byte range","size":100,"range":"bytes=","error":"InvalidRange","status":416},
    {"name":"space inside range","size":100,"range":"bytes= 0-1","error":"InvalidRange","status":416},
    {"name":"multi range","size":100,"range":"bytes=0-1,3-4","error":"InvalidRange","status":416,"note":"API v2 4.1: multi-range không hỗ trợ"},
    {"name":"number overflows int64","size":100,"range":"bytes=99999999999999999999-","error":"InvalidRange","status":416},
    {"name":"plus sign prefix","size":100,"range":"bytes=+1-","error":"InvalidRange","status":416,"note":"chữ số mới hợp lệ, không nhận '+1'"},
    {"name":"other unit is ignored","size":100,"range":"items=0-1","status":200,"length":100,"note":"RFC 9110: unit không nhận diện được thì bỏ qua Range, trả cả object 200"},
    {"name":"no range header","size":100,"status":200,"length":100}
