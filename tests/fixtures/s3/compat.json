    {"name":"plain empty PUT","request":{"method":"PUT","path":"/demo/empty.txt","body":"","content_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},"payload_sha256":"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855","etag_md5":"1B2M2Y8AsgTpgAmY7PhCfg==","checksum":"CRC64NVME AAAAAAAAAAA=","note":"Content-Length 0 + hex SHA-256 của chuỗi rỗng; DSG lưu CRC64NVME khi client không đặt thuật toán (2.7)"},
    {"name":"GET empty object is 200 length 0","status":200,"content_length":0},
    {"name":"open range on empty object is 416","range":"bytes=0-","error":"InvalidRange","status":416},
    {"name":"suffix range on empty object is 416","range":"bytes=-1","error":"InvalidRange","status":416}
