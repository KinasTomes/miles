    {"name":"end clamped to object size","size":100,"range":"bytes=90-1000","status":206,"start":90,"length":10,"content_range":"bytes 90-99/100","note":"S3 kẹp end về size-1 thay vì trả 416 khi start còn hợp lệ"},
    {"name":"last byte open range","size":100,"range":"bytes=99-","status":206,"start":99,"length":1,"content_range":"bytes 99-99/100"},
