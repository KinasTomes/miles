  "head": [
    {"name":"HEAD object response headers","size":100,"status":200,"headers":{"ETag":"\"5f9c4ab08a1f0574f2864e4f33f09e6f\"","Content-Length":"100","Accept-Ranges":"bytes"},"no_body":true,"note":"ETag, Last-Modified, Content-Length, Content-Type, Accept-Ranges; không bao giờ có body"},
    {"name":"HEAD with checksum mode ENABLED","size":100,"request_headers":{"x-amz-checksum-mode":"ENABLED"},"status":200,"headers":{"x-amz-checksum-crc64nvme":"AAAAAAAAAAA=","x-amz-checksum-type":"FULL_OBJECT"},"no_body":true,"note":"object lưu CRC64NVME mặc định (2.7); mode ENABLED trả checksum + type"},
    {"name":"HEAD without checksum mode omits checksum","size":100,"status":200,"no_checksum":true,"no_body":true,"note":"mode vắng mặt không bắt buộc trả checksum (2.7)"},
    {"name":"HEAD missing key has headers only","error":"NoSuchKey","status":404,"no_body":true},
    {"name":"HEAD missing bucket has headers only","error":"NoSuchBucket","status":404,"no_body":true},
    {"name":"HEAD partNumber is P2","request":["HEAD /demo/k?partNumber=1 HTTP/1.1","Host: localhost:8080"],"error":"NotImplemented","status":501,"note":"Resolve trả 501 trước handler, không âm thầm bỏ qua"},
    {"name":"HEAD If-Match is not GetObject","request":["HEAD /demo/k HTTP/1.1","Host: localhost:8080","If-Match: \"abc\""],"error":"NotImplemented","status":501,"note":"If-Match chỉ dành cho GetObject (4.1); ở HEAD là P2 nên 501"},
    {"name":"HEAD keeps common headers on error","error":"NoSuchKey","status":404,"common_headers":["Server","X-Amz-Request-Id","X-Amz-Id-2"],"no_body":true}
  ],
  "xml": [
    {"name":"complete body of the pinned CLI","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>\"5f9c4ab08a1f0574f2864e4f33f09e6f\"</ETag></Part><Part><PartNumber>2</PartNumber><ETag>\"d41d8cd98f00b204e9800998ecf8427e\"</ETag></Part></CompleteMultipartUpload>","parts":2},
    {"name":"delete body","op":"DeleteObjects","body":"<Delete><Object><Key>a&amp;b.txt</Key></Object><Object><Key>caf%C3%A9.txt</Key></Object><Quiet>true</Quiet></Delete>","objects":2,"note":"DeleteObjects của W03/W04 dùng cùng parser"},
    {"name":"declaration comments and whitespace first","op":"CompleteMultipartUpload","body":"<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<!-- uploaded parts -->\n  <CompleteMultipartUpload>\n<Part><PartNumber>1</PartNumber><ETag>\"e\"</ETag></Part></CompleteMultipartUpload>","parts":1},
    {"name":"root with attributes","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload xmlns=\"http://s3.amazonaws.com/doc/2006-03-01/\"><Part><PartNumber>1</PartNumber><ETag>\"e\"</ETag></Part></CompleteMultipartUpload>","parts":1,"note":"namespace/attribute của root không đổi tên local"},
    {"name":"namespace prefixed root","op":"CompleteMultipartUpload","body":"<s3:CompleteMultipartUpload xmlns:s3=\"http://s3.amazonaws.com/doc/2006-03-01/\"><s3:Part><s3:PartNumber>1</s3:PartNumber><s3:ETag>\"e\"</s3:ETag></s3:Part></s3:CompleteMultipartUpload>","parts":1},
    {"name":"cdata in etag","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag><![CDATA[\"abc\"]]></ETag></Part></CompleteMultipartUpload>","parts":1},
    {"name":"doctype","op":"CompleteMultipartUpload","body":"<!DOCTYPE CompleteMultipartUpload [<!ENTITY e \"x\">]><CompleteMultipartUpload><Part><PartNumber>1</PartNumber><ETag>&e;</ETag></Part></CompleteMultipartUpload>","error":"MalformedXML","status":400,"note":"directive bị từ chối ở mọi vị trí nên entity không bao giờ nở"},
    {"name":"two documents","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload></CompleteMultipartUpload><CompleteMultipartUpload></CompleteMultipartUpload>","error":"MalformedXML","status":400},
    {"name":"element after root","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload></CompleteMultipartUpload><Extra/>","error":"MalformedXML","status":400},
    {"name":"text before root","op":"CompleteMultipartUpload","body":"junk<CompleteMultipartUpload></CompleteMultipartUpload>","error":"MalformedXML","status":400},
    {"name":"declaration inside document","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload><?xml version=\"1.0\"?></CompleteMultipartUpload>","error":"MalformedXML","status":400},
    {"name":"wrong root","op":"CompleteMultipartUpload","body":"<Delete></Delete>","error":"MalformedXML","status":400},
    {"name":"truncated document","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload><Part><PartNumber>1</PartNumber>","error":"MalformedXML","status":400},
    {"name":"empty body","op":"CompleteMultipartUpload","body":"","error":"MalformedXML","status":400},
    {"name":"declaration of another encoding","op":"CompleteMultipartUpload","body":"<?xml version=\"1.0\" encoding=\"UTF-16\"?><CompleteMultipartUpload></CompleteMultipartUpload>","error":"MalformedXML","status":400,"note":"bytes UTF-8 nhưng khai báo UTF-16: decoder từ chối"},
    {"name":"body over limit","op":"CompleteMultipartUpload","body":"<CompleteMultipartUpload></CompleteMultipartUpload>","limit":8,"error":"EntityTooLarge","status":400}
