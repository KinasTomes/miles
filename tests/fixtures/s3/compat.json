{
  "sections": {
    "keys": "API v2 3 và 2.4: path-style decode đúng một lần, key echo trong XML error",
    "empty": "API v2 2.2.2, 2.7 và 4.1: empty PUT, GET object rỗng 200 length 0, Range trên object rỗng 416",
    "range": "API v2 4.1 GetObject: bytes=a-b, bytes=a-, bytes=-n; multi-range và invalid trả 416",
    "head": "API v2 4.2 HeadObject: không body kể cả lỗi, checksum mode theo 2.7, partNumber P2 trả 501",
    "xml": "API v2 2.2.2 bước 4 và 4.3.1: body XML đúng một document, sai trả MalformedXML"
  },
  "keys": [
    {"name":"literal plus in path stays plus","request":["GET /demo/a+b HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key":"a+b","note":"Route.Key giữ nguyên '+', chỉ query mới decode '+' thành space"},
    {"name":"double slash inside key kept","request":["GET /demo/a//b HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key":"a//b"},
    {"name":"dot segment kept, no normalization","request":["GET /demo/../x HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key":"../x"},
    {"name":"trailing slash kept on object key","request":["GET /demo/dir/ HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key":"dir/"},
    {"name":"key of only slashes","request":["GET /demo// HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key":"/"},
    {"name":"NFD combining accent is a distinct key","request":["GET /demo/cafe%CC%81.txt HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key":"café.txt","note":"NFC 'café' và NFD 'cafe+U+0301' là hai key byte khác nhau, không chuẩn hóa"},
    {"name":"lowercase percent hex decodes the same","request":["GET /demo/caf%c3%a9.txt HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key":"café.txt"},
    {"name":"invalid UTF-8 byte in key is kept raw","request":["GET /demo/a%FEb HTTP/1.1","Host: localhost:8080"],"op":"GetObject","bucket":"demo","key_hex":"61fe62","note":"key là chuỗi byte, không bắt buộc UTF-8; %FE giữ nguyên một byte"},
    {"name":"query value decodes once","request":["GET /demo?list-type=2&prefix=caf%C3%A9%2B HTTP/1.1","Host: localhost:8080"],"op":"ListObjectsV2","bucket":"demo","key":"","query":{"prefix":"café+"}},
    {"name":"error echoes decoded and escaped key","request":["PUT /demo/caf%C3%A9%20%26%20%3Cx%3E.txt?acl HTTP/1.1","Host: localhost:8080"],"error":"NotImplemented","status":501,"bucket":"demo","key":"café & <x>.txt","error_body_key":"café &amp; &lt;x&gt;.txt","note":"Key decode một lần rồi escape XML, không encode lại"},
    {"name":"invalid UTF-8 key in error becomes U+FFFD","request":["GET /demo/a%FEb?acl HTTP/1.1","Host: localhost:8080"],"error":"NotImplemented","status":501,"bucket":"demo","key_hex":"61fe62","error_body_key_hex":"61efbfbd62","note":"byte không hợp lệ trong XML error được thay bằng U+FFFD (2.4)"}
  ],
  "empty": [
