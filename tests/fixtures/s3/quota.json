{
  "note": "API v2 2.6. Sizes in bytes. attribution: the account charged and the dedup domain used by a write. ledger: one step of the owner ledger each; used/reserved/staged/active_uploads/limit are owner counters, r is the reservation of this writer or upload, base the head size when it was admitted (0 if none), head the current head size at commit, size the logical object or candidate size. On error the counters stay as before.",
  "attribution": [
    {"name": "owner writes its own bucket", "op": "PutObject", "caller": "user-b", "caller_default_domain": "default", "bucket": {"bucket": "b-data", "owner_id": "user-b", "dedup_domain": "default"}, "owner_default_domain": "default", "expect": {"charged_user": "user-b", "domain": "default"}},
    {"name": "grantee writes into another owner's bucket", "op": "PutObject", "caller": "user-a", "caller_default_domain": "tenant-a", "bucket": {"bucket": "b-data", "owner_id": "user-b", "dedup_domain": "default"}, "owner_default_domain": "default", "expect": {"charged_user": "user-b", "domain": "default"}},
    {"name": "owner changed its default domain after creating the bucket", "op": "PutObject", "caller": "user-b", "caller_default_domain": "tenant-b", "bucket": {"bucket": "b-data", "owner_id": "user-b", "dedup_domain": "default"}, "owner_default_domain": "tenant-b", "expect": {"charged_user": "user-b", "domain": "default"}},
    {"name": "copy across domains charges the destination owner", "op": "CopyObject", "caller": "user-c", "caller_default_domain": "default", "source": {"bucket": "a-data", "owner_id": "user-a", "dedup_domain": "tenant-a"}, "bucket": {"bucket": "b-data", "owner_id": "user-b", "dedup_domain": "default"}, "owner_default_domain": "default", "expect": {"charged_user": "user-b", "domain": "default"}},
    {"name": "grantee completes a multipart upload", "op": "CompleteMultipartUpload", "caller": "user-a", "caller_default_domain": "tenant-a", "bucket": {"bucket": "b-private", "owner_id": "user-b", "dedup_domain": "tenant-b"}, "owner_default_domain": "default", "expect": {"charged_user": "user-b", "domain": "tenant-b"}},
    {"name": "admin with a write grant", "op": "PutObject", "caller": "system-root", "caller_default_domain": "default", "bucket": {"bucket": "b-data", "owner_id": "user-b", "dedup_domain": "default"}, "owner_default_domain": "default", "expect": {"charged_user": "user-b", "domain": "default"}},
    {"name": "grantee delete credits the owner", "op": "DeleteObject", "caller": "user-a", "caller_default_domain": "tenant-a", "bucket": {"bucket": "b-data", "owner_id": "user-b", "dedup_domain": "default"}, "owner_default_domain": "default", "expect": {"charged_user": "user-b", "domain": "default"}}
  ],
  "ledger": [
    {"name": "new key fits", "step": "reserve", "used": 600, "reserved": 100, "limit": 1000, "r": 0, "base": 0, "size": 300, "expect": {"r": 300, "reserved": 400, "error": ""}},
    {"name": "new key over the limit by one byte", "step": "reserve", "used": 600, "reserved": 100, "limit": 1000, "r": 0, "base": 0, "size": 301, "expect": {"r": 0, "reserved": 100, "error": "QuotaExceeded"}},
    {"name": "other writers' reservations count", "step": "reserve", "used": 500, "reserved": 300, "limit": 1000, "r": 0, "base": 0, "size": 201, "expect": {"r": 0, "reserved": 300, "error": "QuotaExceeded"}},
    {"name": "same-size overwrite with a full quota", "step": "reserve", "used": 1000, "reserved": 0, "limit": 1000, "r": 0, "base": 200, "size": 200, "expect": {"r": 0, "reserved": 0, "error": ""}},
    {"name": "larger overwrite with a full quota", "step": "reserve", "used": 1000, "reserved": 0, "limit": 1000, "r": 0, "base": 200, "size": 201, "expect": {"r": 0, "reserved": 0, "error": "QuotaExceeded"}},
    {"name": "smaller overwrite", "step": "reserve", "used": 900, "reserved": 0, "limit": 1000, "r": 0, "base": 500, "size": 100, "expect": {"r": 0, "reserved": 0, "error": ""}},
    {"name": "multipart grows its reservation with a new part", "step": "reserve", "used": 0, "reserved": 10485760, "limit": 1099511627776, "r": 10485760, "base": 0, "size": 15728640, "expect": {"r": 15728640, "reserved": 15728640, "error": ""}},
    {"name": "growth counts only the difference", "step": "reserve", "used": 0, "reserved": 10485760, "limit": 20971520, "r": 10485760, "base": 0, "size": 15728640, "expect": {"r": 15728640, "reserved": 15728640, "error": ""}},
    {"name": "growth exactly to the limit", "step": "reserve", "used": 5242880, "reserved": 10485760, "limit": 20971520, "r": 10485760, "base": 0, "size": 15728640, "expect": {"r": 15728640, "reserved": 15728640, "error": ""}},
    {"name": "growth one byte over the limit", "step": "reserve", "used": 5242881, "reserved": 10485760, "limit": 20971520, "r": 10485760, "base": 0, "size": 15728640, "expect": {"r": 10485760, "reserved": 10485760, "error": "QuotaExceeded"}},
    {"name": "multipart inside the overwrite credit", "step": "reserve", "used": 1073741824, "reserved": 0, "limit": 1073741824, "r": 0, "base": 104857600, "size": 62914560, "expect": {"r": 0, "reserved": 0, "error": ""}},
    {"name": "first window of a streamed new key", "step": "grow", "used": 0, "reserved": 0, "limit": 1073741824, "r": 0, "base": 0, "received": 1, "expect": {"r": 67108864, "reserved": 67108864, "error": ""}},
    {"name": "inside the window", "step": "grow", "used": 0, "reserved": 67108864, "limit": 1073741824, "r": 67108864, "base": 0, "received": 67108864, "expect": {"r": 67108864, "reserved": 67108864, "error": ""}},
    {"name": "next window", "step": "grow", "used": 0, "reserved": 67108864, "limit": 1073741824, "r": 67108864, "base": 0, "received": 67108865, "expect": {"r": 134217728, "reserved": 134217728, "error": ""}},
    {"name": "overwrite credit covers the start", "step": "grow", "used": 0, "reserved": 0, "limit": 1073741824, "r": 0, "base": 104857600, "received": 104857600, "expect": {"r": 0, "reserved": 0, "error": ""}},
    {"name": "past the overwrite credit", "step": "grow", "used": 0, "reserved": 0, "limit": 1073741824, "r": 0, "base": 104857600, "received": 104857601, "expect": {"r": 67108864, "reserved": 67108864, "error": ""}},
    {"name": "window denied", "step": "grow", "used": 1006632960, "reserved": 67108864, "limit": 1073741824, "r": 67108864, "base": 0, "received": 67108865, "expect": {"r": 67108864, "reserved": 67108864, "error": "QuotaExceeded"}},
    {"name": "window fits exactly", "step": "grow", "used": 939524096, "reserved": 67108864, "limit": 1073741824, "r": 67108864, "base": 0, "received": 67108865, "expect": {"r": 134217728, "reserved": 134217728, "error": ""}},
    {"name": "end of body releases the slack", "step": "finish", "reserved": 209715200, "r": 134217728, "base": 0, "size": 73400320, "expect": {"r": 73400320, "reserved": 148897792}},
    {"name": "overwrite ends inside the credit", "step": "finish", "reserved": 67108864, "r": 67108864, "base": 104857600, "size": 94371840, "expect": {"r": 0, "reserved": 0}},
    {"name": "commit a new key", "step": "commit", "used": 600, "reserved": 400, "limit": 1000, "r": 300, "size": 300, "head": 0, "expect": {"delta": 300, "used": 900, "reserved": 100, "error": ""}},
    {"name": "commit exactly at the limit", "step": "commit", "used": 700, "reserved": 300, "limit": 1000, "r": 300, "size": 300, "head": 0, "expect": {"delta": 300, "used": 1000, "reserved": 0, "error": ""}},
    {"name": "commit same-size overwrite with a full quota", "step": "commit", "used": 1000, "reserved": 0, "limit": 1000, "r": 0, "size": 200, "head": 200, "expect": {"delta": 0, "used": 1000, "reserved": 0, "error": ""}},
    {"name": "head deleted after admission", "step": "commit", "used": 990, "reserved": 0, "limit": 1000, "r": 0, "size": 200, "head": 0, "expect": {"delta": 200, "used": 990, "reserved": 0, "error": "QuotaExceeded"}},
    {"name": "head grew after admission", "step": "commit", "used": 1000, "reserved": 0, "limit": 1000, "r": 0, "size": 200, "head": 500, "expect": {"delta": -300, "used": 700, "reserved": 0, "error": ""}},
    {"name": "other reservations stay reserved", "step": "commit", "used": 500, "reserved": 450, "limit": 1000, "r": 300, "size": 300, "head": 0, "expect": {"delta": 300, "used": 800, "reserved": 150, "error": ""}},
    {"name": "other reservations block a lost credit", "step": "commit", "used": 600, "reserved": 400, "limit": 1000, "r": 0, "size": 300, "head": 0, "expect": {"delta": 300, "used": 600, "reserved": 400, "error": "QuotaExceeded"}},
    {"name": "shrinking overwrite", "step": "commit", "used": 800, "reserved": 0, "limit": 1000, "r": 0, "size": 100, "head": 500, "expect": {"delta": -400, "used": 400, "reserved": 0, "error": ""}},
    {"name": "release once", "step": "release", "reserved": 400, "r": 300, "released": false, "expect": {"reserved": 100}},
    {"name": "repeated release of the same op_id", "step": "release", "reserved": 100, "r": 300, "released": true, "expect": {"reserved": 100}},
    {"name": "16th active upload", "step": "create_upload", "active_uploads": 15, "expect": {"active_uploads": 16, "error": ""}},
    {"name": "17th active upload", "step": "create_upload", "active_uploads": 16, "expect": {"active_uploads": 16, "error": "QuotaExceeded"}},
    {"name": "staging reaches limit + 100 GiB", "step": "part_admit", "staged": 1206880567296, "limit": 1099511627776, "size": 5242880, "expect": {"staged": 1206885810176, "error": ""}},
    {"name": "staging over limit + 100 GiB by one byte", "step": "part_admit", "staged": 1206880567297, "limit": 1099511627776, "size": 5242880, "expect": {"staged": 1206880567297, "error": "QuotaExceeded"}}
  ]
}
