{
  "note": "API v2 2.2.3. Bucket demo of user-owner, key k exists, upload UP1 on demo/k. s3 rows: requires is the rule of 2.2.3 ('|' = or, '+' = and); cells are the result for each principal when the caller is the initiator of UP1 and the CopyObject source is demo/k. allow = authorized (the handler goes on), listed/hidden = ListBuckets shows demo or not, else an S3 error code. s3_cases change one condition each. snapshot times are milliseconds of the monotonic clock of the node that reads the snapshot. admin cells: allow, 401 or 403.",
  "bucket": {"bucket": "demo", "bucket_id": "bkt-demo-0001", "owner_id": "user-owner", "dedup_domain": "default"},
  "principals": {
    "owner": {"user_id": "user-owner"},
    "reader": {"user_id": "user-reader", "read": true},
    "writer": {"user_id": "user-writer", "write": true},
    "reader_writer": {"user_id": "user-rw", "read": true, "write": true},
    "stranger": {"user_id": "user-stranger"},
    "admin": {"user_id": "system-root", "system_admin": true},
    "admin_reader": {"user_id": "user-ops", "system_admin": true, "read": true},
    "disabled": {"user_id": "user-disabled", "user_status": "disabled", "read": true, "write": true},
    "revoked": {"user_id": "user-revoked", "auth_status": "revoked", "read": true, "write": true}
  },
  "s3": [
    {"op": "ListBuckets", "requires": "listing", "expect": {"owner": "listed", "reader": "listed", "writer": "listed", "reader_writer": "listed", "stranger": "hidden", "admin": "hidden", "admin_reader": "listed", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "CreateBucket", "requires": "create", "expect": {"owner": "BucketAlreadyOwnedByYou", "reader": "BucketAlreadyExists", "writer": "BucketAlreadyExists", "reader_writer": "BucketAlreadyExists", "stranger": "BucketAlreadyExists", "admin": "BucketAlreadyExists", "admin_reader": "BucketAlreadyExists", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "HeadBucket", "requires": "read", "expect": {"owner": "allow", "reader": "allow", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "GetBucketLocation", "requires": "read", "expect": {"owner": "allow", "reader": "allow", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "ListObjectsV2", "requires": "read", "expect": {"owner": "allow", "reader": "allow", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "GetObject", "requires": "read", "expect": {"owner": "allow", "reader": "allow", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "HeadObject", "requires": "read", "expect": {"owner": "allow", "reader": "allow", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "RestoreObject", "requires": "read", "expect": {"owner": "allow", "reader": "allow", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "PutObject", "requires": "write", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "allow", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "AccessDenied", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "DeleteObject", "requires": "write", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "allow", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "AccessDenied", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "DeleteObjects", "requires": "write", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "allow", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "AccessDenied", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "CopyObject", "requires": "write+source_read", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "AccessDenied", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "DeleteBucket", "requires": "owner|admin", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "AccessDenied", "reader_writer": "AccessDenied", "stranger": "AccessDenied", "admin": "allow", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "CreateMultipartUpload", "requires": "write", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "allow", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "AccessDenied", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "UploadPart", "requires": "write+initiator", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "allow", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "AccessDenied", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "CompleteMultipartUpload", "requires": "write+initiator", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "allow", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "AccessDenied", "admin_reader": "AccessDenied", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "AbortMultipartUpload", "requires": "write+initiator|owner|admin", "expect": {"owner": "allow", "reader": "AccessDenied", "writer": "allow", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "allow", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}},
    {"op": "ListParts", "requires": "read+initiator|owner|admin", "expect": {"owner": "allow", "reader": "allow", "writer": "AccessDenied", "reader_writer": "allow", "stranger": "AccessDenied", "admin": "allow", "admin_reader": "allow", "disabled": "AccessDenied", "revoked": "InvalidAccessKeyId"}}
  ],
  "s3_cases": [
    {"name": "revoked key is rejected before the bucket lookup", "op": "GetObject", "principal": "revoked", "bucket": "missing", "expect": "InvalidAccessKeyId"},
    {"name": "disabled user is rejected before the bucket lookup", "op": "GetObject", "principal": "disabled", "bucket": "missing", "expect": "AccessDenied"},
    {"name": "missing bucket comes before the permission check", "op": "PutObject", "principal": "stranger", "bucket": "missing", "expect": "NoSuchBucket"},
    {"name": "admin on a missing bucket", "op": "ListParts", "principal": "admin", "bucket": "missing", "expect": "NoSuchBucket"},
    {"name": "create a free name", "op": "CreateBucket", "principal": "stranger", "bucket": "missing", "expect": "allow"},
    {"name": "disabled user cannot create", "op": "CreateBucket", "principal": "disabled", "bucket": "missing", "expect": "AccessDenied"},
    {"name": "reader sees NoSuchKey", "op": "GetObject", "principal": "reader", "key": "missing", "expect": "NoSuchKey"},
    {"name": "writer gets no key oracle on GET", "op": "GetObject", "principal": "writer", "key": "missing", "expect": "AccessDenied"},
    {"name": "stranger gets no key oracle on HEAD", "op": "HeadObject", "principal": "stranger", "key": "missing", "expect": "AccessDenied"},
    {"name": "restore of a missing key", "op": "RestoreObject", "principal": "reader", "key": "missing", "expect": "NoSuchKey"},
    {"name": "delete of a missing key is 204 for a writer", "op": "DeleteObject", "principal": "writer", "key": "missing", "expect": "allow"},
    {"name": "delete of a missing key needs write", "op": "DeleteObject", "principal": "reader", "key": "missing", "expect": "AccessDenied"},
    {"name": "copy with read on another source bucket", "op": "CopyObject", "principal": "writer", "source": {"read": true}, "expect": "allow"},
    {"name": "copy without read on the source", "op": "CopyObject", "principal": "writer", "source": {"read": false}, "expect": "AccessDenied"},
    {"name": "copy without write on the destination", "op": "CopyObject", "principal": "reader", "source": {"read": true}, "expect": "AccessDenied"},
    {"name": "copy to a missing destination", "op": "CopyObject", "principal": "reader_writer", "bucket": "missing", "source": {"read": true}, "expect": "NoSuchBucket"},
    {"name": "copy from a missing source bucket", "op": "CopyObject", "principal": "writer", "source": {"bucket": "missing"}, "expect": "NoSuchBucket"},
    {"name": "destination is checked before the source bucket", "op": "CopyObject", "principal": "reader", "source": {"bucket": "missing"}, "expect": "AccessDenied"},
    {"name": "copy of a missing source key without read", "op": "CopyObject", "principal": "writer", "source": {"read": false, "key": "missing"}, "expect": "AccessDenied"},
    {"name": "copy of a missing source key with read", "op": "CopyObject", "principal": "writer", "source": {"read": true, "key": "missing"}, "expect": "NoSuchKey"},
    {"name": "another writer cannot upload a part", "op": "UploadPart", "principal": "reader_writer", "initiator": false, "expect": "AccessDenied"},
    {"name": "owner cannot impersonate the initiator on UploadPart", "op": "UploadPart", "principal": "owner", "initiator": false, "expect": "AccessDenied"},
    {"name": "admin cannot upload a part", "op": "UploadPart", "principal": "admin", "initiator": false, "expect": "AccessDenied"},
    {"name": "owner cannot complete for the initiator", "op": "CompleteMultipartUpload", "principal": "owner", "initiator": false, "expect": "AccessDenied"},
    {"name": "another writer cannot complete", "op": "CompleteMultipartUpload", "principal": "reader_writer", "initiator": false, "expect": "AccessDenied"},
    {"name": "owner aborts an upload of a grantee", "op": "AbortMultipartUpload", "principal": "owner", "initiator": false, "expect": "allow"},
    {"name": "admin aborts without a grant", "op": "AbortMultipartUpload", "principal": "admin", "initiator": false, "expect": "allow"},
    {"name": "another writer cannot abort", "op": "AbortMultipartUpload", "principal": "reader_writer", "initiator": false, "expect": "AccessDenied"},
    {"name": "owner lists parts of a grantee", "op": "ListParts", "principal": "owner", "initiator": false, "expect": "allow"},
    {"name": "admin lists parts without a grant", "op": "ListParts", "principal": "admin", "initiator": false, "expect": "allow"},
    {"name": "another reader cannot list parts", "op": "ListParts", "principal": "reader", "initiator": false, "expect": "AccessDenied"},
    {"name": "upload id used with another key", "op": "UploadPart", "principal": "writer", "binding": "other_key", "expect": "NoSuchUpload"},
    {"name": "upload of a deleted and recreated bucket", "op": "CompleteMultipartUpload", "principal": "writer", "binding": "other_bucket_id", "expect": "NoSuchUpload"},
    {"name": "unknown upload id", "op": "UploadPart", "principal": "writer", "binding": "unknown_id", "expect": "NoSuchUpload"},
    {"name": "no upload id oracle without permission", "op": "UploadPart", "principal": "stranger", "binding": "unknown_id", "expect": "AccessDenied"},
    {"name": "admin abort of an unknown upload", "op": "AbortMultipartUpload", "principal": "admin", "binding": "unknown_id", "expect": "NoSuchUpload"},
    {"name": "binding is checked before the initiator", "op": "ListParts", "principal": "reader_writer", "initiator": false, "binding": "other_key", "expect": "NoSuchUpload"}
  ],
  "snapshot": [
    {"name": "cached snapshot younger than 5 s", "phase": "admit", "read_at": 0, "at": 4999, "expect": "allow", "must_reread": false},
    {"name": "age reaches 5 s: re-read even after cache hits", "phase": "admit", "read_at": 0, "at": 5000, "expect": "allow", "must_reread": true},
    {"name": "change after the request", "phase": "admit", "read_at": 0, "at": 4000, "revoked_at": 6000, "expect": "allow", "must_reread": false},
    {"name": "revoked inside the window may still pass", "phase": "admit", "read_at": 0, "at": 4000, "revoked_at": 1000, "expect": "may_allow", "must_reread": false},
    {"name": "snapshot 5 s old is re-read before revoke+5 s", "phase": "admit", "read_at": 999, "at": 5999, "revoked_at": 1000, "expect": "deny", "must_reread": true},
    {"name": "every node denies at revoke+5 s", "phase": "admit", "read_at": 999, "at": 6000, "revoked_at": 1000, "expect": "deny", "must_reread": true},
    {"name": "snapshot read after the revocation", "phase": "admit", "read_at": 1000, "at": 1500, "revoked_at": 1000, "expect": "deny", "must_reread": false},
    {"name": "admitted GET stream runs to the end", "phase": "stream", "read_at": 0, "at": 1800000, "revoked_at": 1000, "expect": "allow", "must_reread": false},
    {"name": "PUT publish after a long body re-reads", "phase": "publish", "read_at": 0, "at": 10000, "revoked_at": 1000, "expect": "deny", "must_reread": true},
    {"name": "PUT publish inside the window may pass", "phase": "publish", "read_at": 0, "at": 3000, "revoked_at": 1000, "expect": "may_allow", "must_reread": false},
    {"name": "token expiry caps the snapshot", "phase": "admit", "read_at": 0, "at": 2000, "expires_at": 2000, "expect": "deny", "must_reread": true},
    {"name": "token before expiry", "phase": "admit", "read_at": 0, "at": 1999, "expires_at": 2000, "expect": "allow", "must_reread": false}
  ],
  "admin": [
    {"endpoint": "GET /admin/v1/buckets/demo", "requires": "owner|admin", "expect": {"owner": "allow", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "GET /admin/v1/buckets/demo/grants", "requires": "owner|admin", "expect": {"owner": "allow", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "PUT /admin/v1/buckets/demo/grants/user-reader", "requires": "owner|admin", "expect": {"owner": "allow", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "DELETE /admin/v1/buckets/demo/grants/user-reader", "requires": "owner|admin", "expect": {"owner": "allow", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "PUT /admin/v1/buckets/demo/policy", "requires": "owner|admin", "expect": {"owner": "allow", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "GET /admin/v1/users/user-writer/usage", "requires": "self|admin", "user_id": "user-writer", "expect": {"owner": "403", "reader": "403", "writer": "allow", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "DELETE /admin/v1/admin-tokens/{token of user-writer}", "requires": "self|admin", "user_id": "user-writer", "expect": {"owner": "403", "reader": "403", "writer": "allow", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "PATCH /admin/v1/users/user-writer", "requires": "admin", "expect": {"owner": "403", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "POST /admin/v1/credentials", "requires": "admin", "expect": {"owner": "403", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "GET /admin/v1/objects/layout?bucket=demo&key=k", "requires": "admin", "expect": {"owner": "403", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}},
    {"endpoint": "GET /admin/v1/buckets/demo/stats", "requires": "admin", "expect": {"owner": "403", "reader": "403", "writer": "403", "reader_writer": "403", "stranger": "403", "admin": "allow", "admin_reader": "allow", "disabled": "401", "revoked": "401"}}
  ]
}
