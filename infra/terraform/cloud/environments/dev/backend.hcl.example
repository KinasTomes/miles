bucket = "miles-dev-tfstate-123456789012-ap-southeast-1"
key = "cloud/dev/terraform.tfstate"
region = "ap-southeast-1"
encrypt = true
use_lockfile = true
# No credentials here. Backend credentials come from the CLI environment/profile.
# CLI is already a deploy-role session. Keep backend/provider on the same identity.
profile = "miles-dev-terraform"
