{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageDevSessionDocument",
      "Effect": "Allow",
      "Action": [
        "ssm:CreateDocument",
        "ssm:UpdateDocument",
        "ssm:UpdateDocumentDefaultVersion",
        "ssm:DescribeDocument",
        "ssm:DescribeDocumentPermission",
        "ssm:GetDocument",
        "ssm:ListDocumentVersions",
        "ssm:AddTagsToResource",
        "ssm:ListTagsForResource"
      ],
      "Resource": [
        "arn:aws:ssm:{{REGION}}:{{ACCOUNT_ID}}:document/{{INSTALLATION_NAME}}-shell"
      ]
    },
    {
      "Sid": "EnterOwnedDevNode",
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "ssm:resourceTag/Project": "Miles",
          "ssm:resourceTag/Environment": "{{ENVIRONMENT}}",
          "ssm:resourceTag/Installation": "{{INSTALLATION_NAME}}",
          "aws:RequestedRegion": "{{REGION}}"
        },
        "BoolIfExists": {
          "ssm:SessionDocumentAccessCheck": "true"
        }
      }
    },
    {
      "Sid": "UseAuditedShell",
      "Effect": "Allow",
      "Action": [
        "ssm:StartSession"
      ],
      "Resource": [
        "arn:aws:ssm:{{REGION}}:{{ACCOUNT_ID}}:document/{{INSTALLATION_NAME}}-shell"
      ],
      "Condition": {
        "BoolIfExists": {
          "ssm:SessionDocumentAccessCheck": "true"
        }
      }
    },
    {
      "Sid": "EndOwnSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:TerminateSession",
        "ssm:ResumeSession"
      ],
      "Resource": [
        "arn:aws:ssm:{{REGION}}:{{ACCOUNT_ID}}:session/*"
      ],
      "Condition": {
        "StringLike": {
          "ssm:resourceTag/aws:ssmmessages:session-id": "${aws:userid}*"
        }
      }
    },
    {
      "Sid": "ReadNodeRegistration",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeInstanceInformation"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "ConnectSessionChannel",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    }
  ]
}
