{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedDevKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateKey"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "ReadAliases",
      "Effect": "Allow",
      "Action": [
        "kms:ListAliases"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "ManageOwnedDevKeys",
      "Effect": "Allow",
      "Action": [
        "kms:DescribeKey",
        "kms:DisableKey",
        "kms:DisableKeyRotation",
        "kms:EnableKey",
        "kms:EnableKeyRotation",
        "kms:GetKeyPolicy",
        "kms:GetKeyRotationStatus",
        "kms:ListResourceTags",
        "kms:PutKeyPolicy",
        "kms:TagResource",
        "kms:UntagResource"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateRuntimeAlias",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:alias/{{INSTALLATION_NAME}}-runtime"
      ]
    },
    {
      "Sid": "BindAliasToOwnedKey",
      "Effect": "Allow",
      "Action": [
        "kms:CreateAlias"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "BootstrapSecretEncryption",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}",
          "kms:ViaService": [
            "ssm.{{REGION}}.amazonaws.com",
            "secretsmanager.{{REGION}}.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "RuntimeSecretMetadata",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:CreateSecret",
        "secretsmanager:DescribeSecret",
        "secretsmanager:GetResourcePolicy",
        "secretsmanager:PutResourcePolicy",
        "secretsmanager:TagResource",
        "secretsmanager:UntagResource"
      ],
      "Resource": [
        "arn:aws:secretsmanager:{{REGION}}:{{ACCOUNT_ID}}:secret:{{RUNTIME_SECRET_NAME}}-*"
      ]
    },
    {
      "Sid": "RuntimeLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:ListTagsForResource",
        "logs:PutRetentionPolicy",
        "logs:TagLogGroup",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:AssociateKmsKey",
        "logs:GetLogEvents",
        "logs:FilterLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/{{INSTALLATION_NAME}}/runtime",
        "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/{{INSTALLATION_NAME}}/runtime:*"
      ]
    },
    {
      "Sid": "ReadLogGroupInventory",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "BootstrapParameter",
      "Effect": "Allow",
      "Action": [
        "ssm:AddTagsToResource",
        "ssm:GetParameter",
        "ssm:ListTagsForResource",
        "ssm:PutParameter",
        "ssm:RemoveTagsFromResource"
      ],
      "Resource": [
        "arn:aws:ssm:{{REGION}}:{{ACCOUNT_ID}}:parameter/{{INSTALLATION_NAME}}/bootstrap-config"
      ]
    },
    {
      "Sid": "ProvisionEncryptedDataServices",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}"
        },
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "UseDevSessionKey",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKey",
        "kms:Decrypt",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "ReadParameterInventory",
      "Effect": "Allow",
      "Action": [
        "ssm:DescribeParameters"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "UseOwnedEBSKeys",
      "Effect": "Allow",
      "Action": [
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:ReEncryptFrom",
        "kms:ReEncryptTo"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}",
          "kms:ViaService": "ec2.{{REGION}}.amazonaws.com"
        }
      }
    }
  ]
}
