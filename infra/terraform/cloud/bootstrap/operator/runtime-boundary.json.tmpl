{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListDevData",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:ListBucketVersions",
        "s3:GetBucketLocation",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": [
        "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}"
      ]
    },
    {
      "Sid": "ReadDevData",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject"
      ],
      "Resource": [
        "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}/*"
      ]
    },
    {
      "Sid": "WriteAndCleanupDevData",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:RestoreObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}/packs/*",
        "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}/packs-index/*",
        "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}/journal/*",
        "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}/checkpoints/*"
      ]
    },
    {
      "Sid": "DevMetadata",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:BatchGetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:Query",
        "dynamodb:Scan",
        "dynamodb:DescribeTable",
        "dynamodb:ConditionCheckItem"
      ],
      "Resource": [
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-*"
      ]
    },
    {
      "Sid": "DevCrypto",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey",
        "kms:DescribeKey"
      ],
      "Resource": [
        "arn:aws:kms:{{REGION}}:{{ACCOUNT_ID}}:key/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "BootstrapConfig",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter"
      ],
      "Resource": [
        "arn:aws:ssm:{{REGION}}:{{ACCOUNT_ID}}:parameter/{{INSTALLATION_NAME}}/bootstrap-config"
      ]
    },
    {
      "Sid": "DevSecrets",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": [
        "arn:aws:secretsmanager:{{REGION}}:{{ACCOUNT_ID}}:secret:{{RUNTIME_SECRET_NAME}}-*"
      ]
    },
    {
      "Sid": "RuntimeLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:{{REGION}}:{{ACCOUNT_ID}}:log-group:/{{INSTALLATION_NAME}}/runtime:*"
      ]
    },
    {
      "Sid": "RuntimeMetrics",
      "Effect": "Allow",
      "Action": [
        "cloudwatch:PutMetricData"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "cloudwatch:namespace": "Miles/DSG"
        }
      }
    },
    {
      "Sid": "DrainDevTargets",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeregisterTargets"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:{{REGION}}:{{ACCOUNT_ID}}:targetgroup/{{INSTALLATION_NAME}}-s3/*"
      ]
    },
    {
      "Sid": "DevLifecycle",
      "Effect": "Allow",
      "Action": [
        "autoscaling:RecordLifecycleActionHeartbeat",
        "autoscaling:CompleteLifecycleAction"
      ],
      "Resource": [
        "arn:aws:autoscaling:{{REGION}}:{{ACCOUNT_ID}}:autoScalingGroup:*:autoScalingGroupName/{{INSTALLATION_NAME}}-*"
      ]
    },
    {
      "Sid": "RegisterDevNode",
      "Effect": "Allow",
      "Action": [
        "ssm:UpdateInstanceInformation"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:instance/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "AgentChannels",
      "Effect": "Allow",
      "Action": [
        "ssmmessages:CreateControlChannel",
        "ssmmessages:CreateDataChannel",
        "ssmmessages:OpenControlChannel",
        "ssmmessages:OpenDataChannel"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "VerifySessionLogEncryption",
      "Effect": "Allow",
      "Action": [
        "logs:DescribeLogGroups"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "ReadVersionedRelease",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": [
        "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}/releases/*"
      ]
    },
    {
      "Sid": "ObserveTargetDrain",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DescribeTargetHealth"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    },
    {
      "Sid": "EdgeBootstrapMaterial",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:{{REGION}}:{{ACCOUNT_ID}}:secret:{{INSTALLATION_NAME}}/edge-bootstrap-*"
    },
    {
      "Sid": "ReadPinnedHelper",
      "Effect": "Allow",
      "Action": [
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}/deployment/helper/*"
    }
  ]
}
