{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageExactStateBucket",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:GetAccelerateConfiguration",
        "s3:GetBucketAcl",
        "s3:GetBucketCORS",
        "s3:GetBucketLogging",
        "s3:GetBucketObjectLockConfiguration",
        "s3:GetBucketPolicy",
        "s3:GetBucketPublicAccessBlock",
        "s3:GetBucketRequestPayment",
        "s3:GetBucketTagging",
        "s3:GetBucketVersioning",
        "s3:GetBucketWebsite",
        "s3:GetEncryptionConfiguration",
        "s3:GetLifecycleConfiguration",
        "s3:GetReplicationConfiguration",
        "s3:ListBucket",
        "s3:PutBucketPolicy",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketTagging",
        "s3:PutBucketVersioning",
        "s3:PutEncryptionConfiguration"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-tfstate-ACCOUNT_ID-ap-southeast-1"
      ]
    },
    {
      "Sid": "ReadAndWriteDevState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-tfstate-ACCOUNT_ID-ap-southeast-1/cloud/dev/terraform.tfstate",
        "arn:aws:s3:::miles-dev-tfstate-ACCOUNT_ID-ap-southeast-1/cloud/dev/terraform.tfstate.tflock"
      ]
    },
    {
      "Sid": "UnlockDevState",
      "Effect": "Allow",
      "Action": [
        "s3:DeleteObject"
      ],
      "Resource": [
        "arn:aws:s3:::miles-dev-tfstate-ACCOUNT_ID-ap-southeast-1/cloud/dev/terraform.tfstate.tflock"
      ]
    }
  ]
}
