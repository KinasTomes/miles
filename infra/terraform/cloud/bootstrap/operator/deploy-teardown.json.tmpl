{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeleteSessionEgress",
      "Effect": "Allow",
      "Action": [
        "ec2:DeleteNatGateway",
        "ec2:ReleaseAddress",
        "ec2:DeleteRoute",
        "ec2:DeleteVpcEndpoints",
        "ec2:DeleteSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:natgateway/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:elastic-ip/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:route-table/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:vpc-endpoint/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "ReadAndDeleteDevLoadBalancer",
      "Effect": "Allow",
      "Action": [
        "elasticloadbalancing:DeleteLoadBalancer",
        "elasticloadbalancing:DeleteTargetGroup",
        "elasticloadbalancing:DeleteListener",
        "elasticloadbalancing:DescribeTags"
      ],
      "Resource": [
        "arn:aws:elasticloadbalancing:{{REGION}}:{{ACCOUNT_ID}}:loadbalancer/app/{{INSTALLATION_NAME}}/*",
        "arn:aws:elasticloadbalancing:{{REGION}}:{{ACCOUNT_ID}}:targetgroup/{{INSTALLATION_NAME}}-s3/*",
        "arn:aws:elasticloadbalancing:{{REGION}}:{{ACCOUNT_ID}}:listener/app/{{INSTALLATION_NAME}}/*/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        }
      }
    }
  ]
}
