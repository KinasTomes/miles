{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AuditDevBucketHistory",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucketVersions",
        "s3:ListBucketMultipartUploads"
      ],
      "Resource": "arn:aws:s3:::{{INSTALLATION_NAME}}-data-{{ACCOUNT_ID}}-{{REGION}}",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "{{EXPIRES_AT}}"
        }
      }
    },
    {
      "Sid": "CountDevMetadata",
      "Effect": "Allow",
      "Action": [
        "dynamodb:DescribeTable",
        "dynamodb:Scan"
      ],
      "Resource": [
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-AdminTokens",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-BucketGrants",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Buckets",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Chunks",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-CompletionPages",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Credentials",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Jobs",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Leases",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-ManifestPages",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Nodes",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Objects",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Outbox",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Packs",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-QuotaReservations",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-RecoveryEpochs",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-SystemConfig",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-UploadPartPages",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-UploadParts",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Uploads",
        "arn:aws:dynamodb:{{REGION}}:{{ACCOUNT_ID}}:table/{{INSTALLATION_NAME}}-Users"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "{{EXPIRES_AT}}"
        }
      }
    },
    {
      "Sid": "InventoryRegionalBackups",
      "Effect": "Allow",
      "Action": [
        "dynamodb:ListBackups",
        "ec2:DescribeSnapshots"
      ],
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "{{EXPIRES_AT}}"
        }
      }
    },
    {
      "Sid": "AuditDevSecretVersions",
      "Effect": "Allow",
      "Action": "secretsmanager:ListSecretVersionIds",
      "Resource": "arn:aws:secretsmanager:{{REGION}}:{{ACCOUNT_ID}}:secret:{{RUNTIME_SECRET_NAME}}-*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}"
        },
        "DateLessThan": {
          "aws:CurrentTime": "{{EXPIRES_AT}}"
        }
      }
    }
  ]
}
