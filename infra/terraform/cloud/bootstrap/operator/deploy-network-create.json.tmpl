{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CreateTaggedStandaloneNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpc",
        "ec2:AllocateAddress",
        "ec2:CreateInternetGateway"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:vpc/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:elastic-ip/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:internet-gateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateTaggedSubnet",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:subnet/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateTaggedRouteTable",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateRouteTable"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:route-table/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateTaggedSecurityGroup",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSecurityGroup"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateTaggedNat",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateNatGateway"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:natgateway/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateTaggedEndpoint",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:vpc-endpoint/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateOnlyInsideOwnedNetwork",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateSubnet",
        "ec2:CreateRouteTable",
        "ec2:CreateSecurityGroup",
        "ec2:CreateNatGateway",
        "ec2:CreateVpcEndpoint"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:vpc/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:subnet/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:elastic-ip/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:route-table/*",
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:ResourceTag/Project": "Miles",
          "aws:ResourceTag/Environment": "{{ENVIRONMENT}}",
          "aws:ResourceTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    },
    {
      "Sid": "CreateTaggedRules",
      "Effect": "Allow",
      "Action": [
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress"
      ],
      "Resource": [
        "arn:aws:ec2:{{REGION}}:{{ACCOUNT_ID}}:security-group-rule/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "{{REGION}}",
          "aws:RequestTag/Project": "Miles",
          "aws:RequestTag/Environment": "{{ENVIRONMENT}}",
          "aws:RequestTag/Installation": "{{INSTALLATION_NAME}}"
        }
      }
    }
  ]
}
